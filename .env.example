# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Cohort 3 Hackathon Evaluation)
# Optional: Default values are provided for local evaluation, but set these for live production Firebase projects
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id



# ---------------------------------------------------------------------------
# Background RSS ingestion (keeps Home rails fresh)
# DISABLE_BACKGROUND_INGESTION=true  → force OFF (wins over everything)
# ENABLE_BACKGROUND_INGESTION=true   → force ON
# Default: ON when NODE_ENV is not "production" (local/dev); OFF in production
# unless ENABLE_BACKGROUND_INGESTION=true.
# ---------------------------------------------------------------------------
# ENABLE_BACKGROUND_INGESTION=true
# DISABLE_BACKGROUND_INGESTION=true
